{
  "name": "arkdraw",
  "private": true,
  "version": "0.1.0",
  "description": "An open-source, native desktop diagramming app.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "app:build:mac-universal": "tauri build --target universal-apple-darwin",
    "app:icons": "tauri icon app-icon.svg",
    "icons:fetch": "node scripts/icons/fetch-icons.mjs",
    "icons:check-descriptions": "node scripts/icons/check-descriptions.mjs",
    "build:web": "tsc --noEmit && vite build",
    "postbuild:web": "node scripts/web/csp.mjs dist --headers",
    "preview:web": "vite preview --port 4173",
    "pwa:icons": "node scripts/web/pwa-icons.mjs",
    "docker:build": "docker build -t opendraw .",
    "docker:run": "docker run --rm -p 8080:8080 opendraw",
    "media:gifs": "node scripts/media/render-diagram-gifs.mjs",
    "media:ai": "node --experimental-websocket scripts/media/record-ai-demo.mjs",
    "smoke:prod": "node --experimental-websocket scripts/smoke/prod.mjs",
    "site:dev": "cd site && npx --yes wrangler@4 dev --port 8788"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "elkjs": "0.12.0",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.61.0",
    "mathjax-full": "^3.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "roughjs": "^4.6.6",
    "svg2pdf.js": "^2.8.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@iconify-json/logos": "^1.2.17",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.4",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "workbox-window": "^7.4.1"
  }
}
