{
  "name": "ArkDraw",
  "short_name": "ArkDraw",
  "description": "Open-source diagramming for flowcharts, UML, ER diagrams and network maps. Works offline.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#eeeef1",
  "theme_color": "#5b5bf6",
  "categories": ["productivity", "design", "utilities"],
  "icons": [
    { "src": "pwa/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "pwa/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "pwa/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/x-arkdraw+json": [".arkdraw"],
        "application/vnd.jgraph.mxfile": [".drawio"]
      },
      "icons": [{ "src": "pwa/file-256.png", "sizes": "256x256", "type": "image/png" }]
    }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
