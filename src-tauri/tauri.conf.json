{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenDraw",
  "version": "0.1.0",
  "identifier": "app.opendraw.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "OpenDraw",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "visible": false,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://fonts.googleapis.com https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "Native, offline diagramming",
    "longDescription": "OpenDraw is an open-source, fully offline diagramming app for flowcharts, UML, ER diagrams and network maps. A modern alternative to draw.io.",
    "publisher": "OpenDraw",
    "copyright": "Copyright (c) 2026 Gabriel Santana. MIT License.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/gabe-santana/opendraw",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["opendraw"],
        "name": "OpenDraw Diagram",
        "description": "OpenDraw Diagram",
        "role": "Editor",
        "mimeType": "application/x-opendraw+json"
      },
      {
        "ext": ["drawio"],
        "name": "draw.io Diagram",
        "description": "draw.io Diagram",
        "role": "Editor",
        "mimeType": "application/vnd.jgraph.mxfile"
      },
      {
        "ext": ["vsdx"],
        "name": "Visio Drawing",
        "description": "Microsoft Visio Drawing",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/vnd.ms-visio.drawing.main+xml"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_THE_PUBLIC_KEY_FROM_tauri_signer_generate (see docs/release.md)",
      "endpoints": ["https://github.com/gabe-santana/opendraw/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
