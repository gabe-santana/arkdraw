// Cloudflare Workers deployment of the landing page (https://arkdraw.com and
// https://www.arkdraw.com). The editor itself is a separate Worker at
// https://app.arkdraw.com (../wrangler.jsonc).
//
// Static assets, plus a tiny Worker for the videos (/media/*) only, so page
// requests don't count against the free plan.
// Deployed by .github/workflows/deploy-web.yml; credentials are repository
// secrets, never stored in the repo.
{
  "name": "arkdraw-site",
  "compatibility_date": "2026-10-01",
  // Only /media/* runs code (range requests for the videos, see worker.js);
  // everything else is served straight from the assets.
  "main": "worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/media/*"]
  },
  "routes": [
    { "pattern": "arkdraw.com", "custom_domain": true },
    { "pattern": "www.arkdraw.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
